# GitLab CI Environment Variables for Local Testing
#
# Usage:
#   1. Copy this file to .env (gitignored)
#   2. Fill in GITLAB_TOKEN with your personal access token
#   3. Source before running: source ci/.env && python3 ci/merge_upstream.py

# Git authentication and GitLab API (CRITICAL - needs write access to main branch and MRs)
export GITLAB_TOKEN="your-token-here"  # Get from GitLab CI/CD variables

# GitLab server details
export CI_SERVER_HOST="codehub.sva.de"
export CI_PROJECT_PATH="sva-soc/soc-infrastructure/elastic/elastic-integrations-soc"

# GitLab API endpoints
export CI_API_V4_URL="https://codehub.sva.de/api/v4"
export CI_PROJECT_ID="16196"
export CI_PROJECT_URL="https://codehub.sva.de/sva-soc/soc-infrastructure/elastic/elastic-integrations-soc"

# Pipeline metadata
export CI_PIPELINE_SOURCE="schedule"

# Script configuration (optional overrides)
export FIX_BRANCH="auto-fix-dynamic-flags"
export MR_TARGET="main"
export API_TIMEOUT="30"
